# TravelSync Environment Variables Configuration Template
# Copy this file to .env or export these in your deployment environment

# Backend Server Port (Default: 8081)
PORT=8081

# Frontend API Base URL
VITE_API_BASE_URL=http://localhost:8081

# Optional External API Keys (Defaults use 100% free open-access endpoints: Open-Meteo, Wikipedia, OSRM, Overpass)
GEOAPIFY_API_KEY=
OPENTRIPMAP_API_KEY=
